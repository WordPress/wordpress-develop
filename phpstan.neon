# PHPStan configuration for WordPress AI Security Edition

includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: 5
  paths:
    - src/wp-includes/ai-client
  excludePaths:
    - vendor/*
    - node_modules/*
  ignoreErrors:
    - '#Function .+ not found#'
    - '#Class .+ not found#'