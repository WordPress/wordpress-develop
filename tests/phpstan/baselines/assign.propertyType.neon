			identifier: assign.propertyType
			count: 1
			path: ../../../src/wp-includes/class-wpdb.php
		-
			message: '#^Property WP_Customize_Header_Image_Control\:\:\$default_headers \(string\) does not accept array\.$#'
			identifier: assign.propertyType
			count: 1
			path: ../../../src/wp-includes/customize/class-wp-customize-header-image-control.php
		-
			message: '#^Property WP_Customize_Header_Image_Control\:\:\$uploaded_headers \(string\) does not accept array\.$#'
			identifier: assign.propertyType
			count: 1
			path: ../../../src/wp-includes/customize/class-wp-customize-header-image-control.php
		-
