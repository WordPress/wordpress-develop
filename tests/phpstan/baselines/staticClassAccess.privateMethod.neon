			identifier: staticClassAccess.privateMethod
			count: 1
			path: ../../../src/wp-includes/fonts/class-wp-font-face-resolver.php
		-
			message: '#^Unsafe call to private method WP_Font_Face_Resolver\:\:to_theme_file_uri\(\) through static\:\:\.$#'
