			message: '#^Use placeholders and \$wpdb\-\>prepare\(\); found interpolated variable \$extra_checks in the query passed to \$wpdb\-\>prepare\(\)\.$#'
			identifier: WordPress.DB.PreparedSQL.InterpolatedNotPrepared
			count: 1
			path: ../../../src/wp-admin/includes/class-wp-list-table.php
