# PHPStan baseline for the `argument.type` errors in WordPress core.
#
# https://phpstan.org/error-identifiers/argument.type
#
# Each entry is scoped to a single file and carries an exact occurrence count,
# so that a new instance is reported as a new error rather than being absorbed
# silently. Fixing an occurrence therefore means decrementing or removing its
# entry here as part of the same change.
#
# The goal is to empty this file and delete it.
#
# Generated by `composer phpstan:baselines`. Do not edit by hand. Regenerate with:
#
#     composer phpstan:baselines -- --identifier=argument.type --config=phpstan-strict.neon.dist
#
# This reruns the analysis with the baselines in this directory suppressed, so
# that their errors surface again, and rewrites only this file.

parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$object_or_string of function is_a expects object\|string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: ../../../src/wp-includes/abilities-api/class-wp-abilities-registry.php
		-
			message: '#^Parameter \#1 \$args of function wp_parse_args expects array\<string, mixed\>\|object\|string, mixed given\.$#'
			identifier: argument.type
			count: 2
			path: ../../../src/wp-includes/abilities-api/class-wp-ability.php
		-
			message: '#^Parameter \#1 \$name of method WordPress\\AiClientDependencies\\Psr\\Http\\Message\\MessageInterface\:\:withHeader\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: ../../../src/wp-includes/ai-client/adapters/class-wp-ai-client-http-client.php
		-
			message: '#^Parameter \#2 \$value of method WordPress\\AiClientDependencies\\Psr\\Http\\Message\\MessageInterface\:\:withHeader\(\) expects array\<string\>\|string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: ../../../src/wp-includes/ai-client/adapters/class-wp-ai-client-http-client.php
		-
			message: '#^Parameter \#4 \$options of static method WP_Style_Engine_CSS_Declarations\:\:filter_declaration\(\) expects array\{important\?\: bool, \.\.\.\}, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: ../../../src/wp-includes/style-engine/class-wp-style-engine-css-declarations.php
		-
			message: '#^Parameter \#3 \$options of method WP_Style_Engine_CSS_Declarations\:\:add_declaration\(\) expects array\{important\?\: bool, \.\.\.\}, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: ../../../src/wp-includes/style-engine/class-wp-style-engine-css-rule.php
		-
			message: '#^Parameter \#1 \$should_prettify of method WP_Style_Engine_CSS_Rule\:\:get_css\(\) expects bool, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: ../../../src/wp-includes/style-engine/class-wp-style-engine-processor.php
