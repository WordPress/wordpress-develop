		-
			message: '#^Parameter \#1 \$args of function wp_parse_args expects array\<string, mixed\>\|object\|string, array given\.$#'
			identifier: argument.type
			count: 1
			path: ../../../src/wp-includes/class-wp-query.php
		-
			message: '#^Parameter \#1 \$args of function wp_parse_args expects array\<string, mixed\>\|object\|string, array\|string given\.$#'
			identifier: argument.type
			count: 1
			path: ../../../src/wp-includes/class-wp-query.php
		-
			message: '#^Parameter \#1 \$arr1 of function array_intersect expects an array of values castable to string, array\<int, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: ../../../src/wp-includes/class-wp-query.php
		-
