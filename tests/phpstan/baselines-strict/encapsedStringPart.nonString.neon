# PHPStan baseline for the `encapsedStringPart.nonString` errors in WordPress core.
#
# https://phpstan.org/error-identifiers/encapsedStringPart.nonString
#
# Each entry is scoped to a single file and carries an exact occurrence count,
# so that a new instance is reported as a new error rather than being absorbed
# silently. Fixing an occurrence therefore means decrementing or removing its
# entry here as part of the same change.
#
# The goal is to empty this file and delete it.
#
# Generated by `composer phpstan:baselines`. Do not edit by hand. Regenerate with:
#
#     composer phpstan:baselines -- --identifier=encapsedStringPart.nonString --config=phpstan-strict.neon.dist
#
# This reruns the analysis with the baselines in this directory suppressed, so
# that their errors surface again, and rewrites only this file.

parameters:
	ignoreErrors:
		-
			message: '#^Part \$meta_clause\[''alias''\] \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 1
			path: ../../../src/wp-includes/class-wp-query.php
		-
			message: '#^Part \$meta_clause\[''cast''\] \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 1
			path: ../../../src/wp-includes/class-wp-query.php
		-
			message: '#^Part \$primary_meta_query\[''alias''\] \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 3
			path: ../../../src/wp-includes/class-wp-query.php
		-
			message: '#^Part \$primary_meta_query\[''cast''\] \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 1
			path: ../../../src/wp-includes/class-wp-query.php
