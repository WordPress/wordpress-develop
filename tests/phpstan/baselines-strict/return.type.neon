# PHPStan baseline for the `return.type` errors in WordPress core.
#
# https://phpstan.org/error-identifiers/return.type
#
# Each entry is scoped to a single file and carries an exact occurrence count,
# so that a new instance is reported as a new error rather than being absorbed
# silently. Fixing an occurrence therefore means decrementing or removing its
# entry here as part of the same change.
#
# The goal is to empty this file and delete it.
#
# Generated by `composer phpstan:baselines`. Do not edit by hand. Regenerate with:
#
#     composer phpstan:baselines -- --identifier=return.type --config=phpstan-strict.neon.dist
#
# This reruns the analysis with the baselines in this directory suppressed, so
# that their errors surface again, and rewrites only this file.

parameters:
	ignoreErrors:
		-
			message: '#^Method WP_Ability_Categories_Registry\:\:get_all_registered\(\) should return array\<string, WP_Ability_Category\> but returns array\<WP_Ability_Category\>\.$#'
			identifier: return.type
			count: 1
			path: ../../../src/wp-includes/abilities-api/class-wp-ability-categories-registry.php
		-
			message: '#^Method WP_Query\:\:fill_query_vars\(\) should return array\{error\: array\<bool\|float\|int\|string\>\|bool\|float\|int\|string, m\: array\<bool\|float\|int\|string\>\|bool\|float\|int\|string, p\: array\<bool\|float\|int\|string\>\|bool\|float\|int\|string, post_parent\: array\<bool\|float\|int\|string\>\|bool\|float\|int\|string, subpost\: array\<bool\|float\|int\|string\>\|bool\|float\|int\|string, subpost_id\: array\<bool\|float\|int\|string\>\|bool\|float\|int\|string, attachment\: array\<bool\|float\|int\|string\>\|bool\|float\|int\|string, attachment_id\: array\<bool\|float\|int\|string\>\|bool\|float\|int\|string, \.\.\., \.\.\.\<mixed\>\} but returns non\-empty\-array\<mixed\>\.$#'
			identifier: return.type
			count: 1
			path: ../../../src/wp-includes/class-wp-query.php
		-
			message: '#^Method WP_Query\:\:get_queried_object\(\) should return WP_Post\|WP_Post_Type\|WP_Term\|WP_User\|null but returns array\|object\|null\.$#'
			identifier: return.type
			count: 1
			path: ../../../src/wp-includes/class-wp-query.php
		-
			message: '#^Method WP_Query\:\:get_search_stopwords\(\) should return array\<string\> but returns array\.$#'
			identifier: return.type
			count: 1
			path: ../../../src/wp-includes/class-wp-query.php
		-
			message: '#^Method WP_Query\:\:next_post\(\) should return WP_Post but returns int\|stdClass\|WP_Post\.$#'
			identifier: return.type
			count: 1
			path: ../../../src/wp-includes/class-wp-query.php
