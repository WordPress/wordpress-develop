# PHPStan configuration holding selected parts of WordPress Core to rule level 10.
#
# phpstan.neon.dist analyzes the whole codebase at a lower rule level. This analyzes it at level 10, and reports
# only the errors in the paths listed under `strictPaths` below, so that code which already meets the stricter
# level, mostly code added in recent releases, keeps meeting it. `composer phpstan` runs both analyses.
#
# The analysis covers every path phpstan.neon.dist does, rather than only the strict paths, and filters the errors
# afterward. The WordPress-specific parser node visitors in tests/phpstan only rewrite the docblocks of the files
# that are analyzed, so narrowing the analyzed paths would read every function outside them without the types those
# visitors derive, such as the array shapes from hash notation. See tests/phpstan/README.md.
#
# To override this configuration, create a phpstan-level-10.neon which includes this file, in the same way as
# phpstan.neon overrides phpstan.neon.dist.
#
# https://phpstan.org/config-reference

includes:
	# Everything phpstan.neon.dist enforces: the base configuration, the strict rules, the errors ignored as not
	# actionable, and its baselines. An error that both analyses report is baselined once, by phpstan.neon.dist.
	- phpstan.neon.dist

	# Preexisting errors at this level in the strict paths, beyond those baselined by phpstan.neon.dist. They are
	# organized and regenerated the same way, by `composer phpstan:baselines`, which rewrites both the files and the
	# list between the markers. Do not edit that list by hand.
	# phpstan:baselines start
	- tests/phpstan/baselines-level-10/argument.type.neon
	- tests/phpstan/baselines-level-10/cast.int.neon
	- tests/phpstan/baselines-level-10/method.notFound.neon
	- tests/phpstan/baselines-level-10/missingType.iterableValue.neon
	- tests/phpstan/baselines-level-10/missingType.return.neon
	- tests/phpstan/baselines-level-10/offsetAccess.nonOffsetAccessible.neon
	- tests/phpstan/baselines-level-10/return.type.neon
	# phpstan:baselines end

services:
	# Drops every error reported outside the strict paths.
	# See tests/phpstan/StrictPathsIgnoreErrorExtension.php.
	-
		class: WordPress\PHPStan\StrictPathsIgnoreErrorExtension
		arguments:
			paths: %strictPaths%
		tags:
			- phpstan.ignoreErrorExtension

parametersSchema:
	strictPaths: listOf(string())

parameters:
	# https://phpstan.org/user-guide/rule-levels
	level: 10

	# The two analyses share the cache of what PHPStan reads from each file, since both parse every file the same way,
	# but each needs its own result cache. Its metadata includes the rule level, so a shared one would be discarded by
	# every run of the other analysis.
	resultCachePath: %tmpDir%/resultCache-level-10.php

	# The errors outside the strict paths are dropped before the ignores are matched against them, so every
	# `@phpstan-ignore` comment and baseline entry outside the strict paths would be reported as unmatched. Those are
	# checked by phpstan.neon.dist instead. The entries of this configuration's own baselines each set
	# `reportUnmatched: true`, which overrides this, so a stale one is still reported.
	reportUnmatchedIgnoredErrors: false

	# The paths held to this rule level, relative to the repository root. A path ending in a slash is a directory, and
	# covers every file below it. Any other path is a file. Each path must exist.
	#
	# Before adding a path, fix the errors this analysis reports in it, or baseline those that cannot be fixed yet.
	strictPaths:
		- src/wp-admin/includes/class-wp-filesystem-base.php
		- src/wp-admin/includes/class-wp-filesystem-direct.php
		- src/wp-admin/includes/class-wp-filesystem-ssh2.php
		- src/wp-includes/abilities-api/
		- src/wp-includes/abilities-api.php
		- src/wp-includes/ai-client/
		- src/wp-includes/ai-client.php
		- src/wp-includes/class-wp-block-styles-registry.php
		- src/wp-includes/class-wp-block-template.php
		- src/wp-includes/class-wp-comment.php
		- src/wp-includes/class-wp-connector-registry.php
		- src/wp-includes/class-wp-error.php
		- src/wp-includes/class-wp-post.php
		- src/wp-includes/class-wp-url-pattern-prefixer.php
		- src/wp-includes/html-api/class-wp-html-attribute-token.php
		- src/wp-includes/html-api/class-wp-html-decoder.php
		- src/wp-includes/html-api/class-wp-html-doctype-info.php
		- src/wp-includes/html-api/class-wp-html-processor-state.php
		- src/wp-includes/html-api/class-wp-html-span.php
		- src/wp-includes/html-api/class-wp-html-stack-event.php
		- src/wp-includes/html-api/class-wp-html-text-replacement.php
		- src/wp-includes/html-api/class-wp-html-token.php
		- src/wp-includes/html-api/class-wp-html-unsupported-exception.php
		- src/wp-includes/l10n/class-wp-translations.php
		- src/wp-includes/secrets/
		- src/wp-includes/secrets.php
		- src/wp-includes/sitemaps.php
		- src/wp-includes/speculative-loading.php
		- src/wp-includes/style-engine/
		- tests/phpstan/
